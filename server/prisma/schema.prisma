generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String?
  role          String         @default("CUSTOMER")
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Product {
  id         Int                @id @default(autoincrement())
  name       String
  type       String
  salesPrice Float
  costPrice  Float
  notes      String?
  variants   ProductVariant[]
  lines      SubscriptionLine[]
  discounts  Discount[]
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  attribute  String
  value      String
  extraPrice Float   @default(0)
  product    Product @relation(fields: [productId], references: [id])
}

model Plan {
  id              Int                 @id @default(autoincrement())
  name            String
  price           Float
  billingPeriod   String
  minQuantity     Int                 @default(1)
  startDate       DateTime
  endDate         DateTime?
  autoClose       Boolean             @default(false)
  allowPause      Boolean             @default(false)
  allowRenew      Boolean             @default(false)
  allowEarlyClose Boolean             @default(false)
  subscriptions   Subscription[]
  templates       QuotationTemplate[]
}

model QuotationTemplate {
  id           Int    @id @default(autoincrement())
  name         String
  planId       Int
  validityDays Int
  linesJson    String
  plan         Plan   @relation(fields: [planId], references: [id])
}

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String             @unique
  customerId      Int
  planId          Int
  status          String             @default("DRAFT")
  startDate       DateTime
  expiryDate      DateTime
  paymentTerms    String?
  nextBillingDate DateTime?
  createdAt       DateTime           @default(now())
  customer        User               @relation(fields: [customerId], references: [id])
  plan            Plan               @relation(fields: [planId], references: [id])
  lines           SubscriptionLine[]
  invoices        Invoice[]
  discounts       Discount[]
}

model SubscriptionLine {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  productId      Int
  quantity       Int
  unitPrice      Float
  taxId          Int?
  amount         Float
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  tax            Tax?         @relation(fields: [taxId], references: [id])
}

model Tax {
  id       Int                @id @default(autoincrement())
  name     String
  ratePct  Float
  subLines SubscriptionLine[]
  invLines InvoiceLine[]
}

model Discount {
  id             Int           @id @default(autoincrement())
  name           String
  type           String
  value          Float
  minPurchase    Float?
  minQuantity    Int?
  startDate      DateTime
  endDate        DateTime
  usageLimit     Int?
  timesUsed      Int           @default(0)
  productId      Int?
  subscriptionId Int?
  product        Product?      @relation(fields: [productId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  number             String        @unique
  subscriptionId     Int
  status             String        @default("DRAFT")
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  billingPeriodStart DateTime
  subtotal           Float
  taxTotal           Float
  discountTotal      Float         @default(0)
  total              Float
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id])
  lines              InvoiceLine[]
  payments           Payment[]

  @@unique([subscriptionId, billingPeriodStart])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Int
  unitPrice   Float
  taxId       Int?
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  tax         Tax?    @relation(fields: [taxId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  method    String
  amount    Float
  paidAt    DateTime
  note      String?
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}
